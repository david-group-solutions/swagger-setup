<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <AssemblyVersion>$(VersionPrefix.Substring(0,3)).0.0</AssemblyVersion>

    <Company>David Group Solutions</Company>
    <Product>SwaggerSetup</Product>
    <Description>Ready-to-use Swagger configuration for fast and effortless API documentation setup.</Description>
    <Authors>David Khachatryan; David Group Solutions</Authors>
    <Copyright>Copyright (c) 2025-2026 David Khachatryan (David Group Solutions)</Copyright>

    <PackageId>DavidGroup.Core.SwaggerSetup</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageTags>SwaggerSetup;Swagger;Documentation;Extensions;Helpers;Kit;Instrumentation</PackageTags>
    <PackageProjectUrl>https://github.com/david-group-solutions/swagger-setup</PackageProjectUrl>

    <RepositoryUrl>https://github.com/david-group-solutions/swagger-setup</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" Visible="false" PackagePath="/"/>
    <None Include="../../README.md" Pack="true" Visible="true" PackagePath="/"/>
    <None Include="../../LICENSE.txt" Pack="true" Visible="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1"/>
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0"/>
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.1.0"/>
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.1.0"/>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.0"/>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.0"/>
  </ItemGroup>

  <!-- Per-TFM `ItemGroup` for exceptions only: -->

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.22"/>
  </ItemGroup>

</Project>
